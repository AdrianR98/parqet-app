# Copy to a local .env file and fill locally only.
# Do not commit real secrets, tokens, cookies, OAuth codes or private portfolio data.

PARQET_CLIENT_ID=
PARQET_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Enables local/development-only Parqet API field audit routes.
# Keep false unless you intentionally run the audit locally.
ENABLE_PARQET_AUDIT_ROUTES=false

# Enables local/development-only Global Asset audit/report route.
# This route is hard-blocked in production and must never expose raw payloads.
ENABLE_GLOBAL_ASSET_AUDIT_ROUTES=false
